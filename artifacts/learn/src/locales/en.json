  "courseContent": {
    "courses": {
      "pythonFundamentals": {
        "title": "Python Fundamentals",
        "description": "Master the basics of Python programming from scratch. Learn variables, control flow, functions, and data structures through hands-on exercises."
      },
      "javascriptEssentials": {
        "title": "JavaScript Essentials",
        "description": "Learn JavaScript from zero to building interactive web applications. Master variables, functions, DOM manipulation, and modern ES6+ features."
      },
      "htmlFundamentals": {
        "title": "HTML Fundamentals",
        "description": "Learn to structure web pages with HTML. Master semantic elements, forms, tables, and accessibility best practices."
      },
      "cssStylingMastery": {
        "title": "CSS Styling Mastery",
        "description": "Style beautiful web pages with CSS. Learn selectors, the box model, flexbox, grid, animations, and responsive design."
      },
      "sqlForBeginners": {
        "title": "SQL for Beginners",
        "description": "Learn to query and manage databases with SQL. Master SELECT, JOIN, aggregation, and data manipulation for real-world applications."
      },
      "cppProgramming": {
        "title": "C++ Programming",
        "description": "Learn C++ from the ground up: variables, control flow, functions, pointers, OOP, and the STL. Build fast, efficient programs."
      },
      "javaProgramming": {
        "title": "Java Programming",
        "description": "Learn Java fundamentals: syntax, OOP, collections, exception handling, and more. Build robust, portable applications."
      }
    },
    "modules": {
      "gettingStartedWithPython": { "title": "Getting Started with Python", "description": "Write your first Python programs" },
      "variablesAndDataTypes": { "title": "Variables and Data Types", "description": "Learn how to store and work with data" },
      "controlFlow": { "title": "Control Flow", "description": "Make decisions and repeat actions" },
      "loops": { "title": "Loops", "description": "Repeat actions with for and while loops" },
      "functions": { "title": "Functions", "description": "Write reusable code with functions" },
      "dataStructures": { "title": "Data Structures", "description": "Work with lists and dictionaries" },
      "javascriptBasics": { "title": "JavaScript Basics", "description": "Your first JavaScript programs" },
      "functionsAndArrays": { "title": "Functions and Arrays", "description": "Write reusable code and work with collections" },
      "objectsAndControlFlow": { "title": "Objects and Control Flow", "description": "Work with objects and conditional logic" },
      "loopsAndIteration": { "title": "Loops and Iteration", "description": "Master different loop types" },
      "stringMethods": { "title": "String Methods", "description": "Manipulate text with string methods" },
      "errorHandlingModernJs": { "title": "Error Handling & Modern JS", "description": "Handle errors and use modern JavaScript features" },
      "htmlBasics": { "title": "HTML Basics", "description": "Structure and basic tags" },
      "linksImagesLists": { "title": "Links, Images & Lists", "description": "Add links, images, and lists" },
      "htmlForms": { "title": "HTML Forms", "description": "Create interactive forms" },
      "semanticHtml": { "title": "Semantic HTML", "description": "Write meaningful, accessible HTML" },
      "tablesAndMedia": { "title": "Tables and Media", "description": "Display tabular data and embed media" },
      "cssBasics": { "title": "CSS Basics", "description": "Selectors, colors, and text styling" },
      "boxModel": { "title": "The Box Model", "description": "Understand margins, padding, and borders" },
      "flexboxLayout": { "title": "Flexbox Layout", "description": "Create flexible layouts with flexbox" },
      "cssGrid": { "title": "CSS Grid", "description": "Create two-dimensional layouts" },
      "responsiveDesign": { "title": "Responsive Design", "description": "Make websites work on all devices" },
      "sqlBasics": { "title": "SQL Basics", "description": "Your first SQL queries" },
      "sortingAndAggregation": { "title": "Sorting and Aggregation", "description": "Order results and calculate totals" },
      "joinOperations": { "title": "JOIN Operations", "description": "Combine data from multiple tables" },
      "dataManipulation": { "title": "Data Manipulation", "description": "Insert, update, and delete data" },
      "advancedQueries": { "title": "Advanced Queries", "description": "Subqueries, aliases, and string functions" },
      "gettingStartedWithCpp": { "title": "Getting Started with C++", "description": "Your first C++ programs" },
      "arraysAndStrings": { "title": "Arrays & Strings", "description": "Working with collections of data" },
      "oopInCpp": { "title": "OOP in C++", "description": "Classes and object-oriented programming" },
      "javaBasics": { "title": "Java Basics", "description": "Getting started with Java" },
      "methodsAndFunctions": { "title": "Methods & Functions", "description": "Defining and using methods" },
      "oopInJava": { "title": "OOP in Java", "description": "Classes, inheritance, interfaces" },
      "collectionsAndGenerics": { "title": "Collections & Generics", "description": "ArrayList, HashMap, and generics" }
    }
